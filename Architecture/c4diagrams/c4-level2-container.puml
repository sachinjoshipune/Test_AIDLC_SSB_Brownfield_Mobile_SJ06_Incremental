@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.11.0/C4_Container.puml
LAYOUT_WITH_LEGEND()
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultTextAlignment center

title Container Diagram — SB360 Mobile Application

Person(visitor, "Visitor", "Single end-user role; anonymous or authenticated")

System_Boundary(sb360System, "SB360 Mobile App") {
  Container(rnApp, "React Native App", "React Native 0.74.x, TypeScript", "Single codebase producing iOS and Android shells; hosts Bottom Navigation Bar, bilingual EN/AR UI, Redux Toolkit state, React Navigation")
  Container(apiClient, "API Client Module", "Axios instance", "Centralized HTTP client; API_BASE_URL + API_TIMEOUT_MS=10000; interceptor-based error-to-UI mapping")
  ContainerDb(asyncStorage, "AsyncStorage", "Device local key-value store", "Caches non-PII: language preference, nav config, last-active tab")
  ContainerDb(keychain, "Keychain/Keystore", "Device secure key-value store", "Stores PII (email, displayName) and auth tokens")
}

System_Ext(sb360Backend, "SB360 Backend API", "Existing, undocumented REST/JSON API (API-001..API-006)")
System_Ext(telemetrySvc, "Error/Crash Telemetry Service", "Vendor TBD; PII-free audit/crash events")

Rel(visitor, rnApp, "Taps nav items, switches language, views screens", "Touch UI")
Rel(rnApp, apiClient, "Issues nav/i18n/profile/section requests", "In-process call")
Rel(apiClient, sb360Backend, "GET/PUT navigation, i18n, profile, section, health", "HTTPS/REST JSON, TLS 1.2+, Bearer JWT where required")
Rel(rnApp, asyncStorage, "Reads/writes cached locale, nav config, last-active tab", "AsyncStorage API")
Rel(rnApp, keychain, "Reads/writes PII and auth tokens", "Keychain/Keystore API")
Rel(rnApp, telemetrySvc, "Emits state-transition audit events and crash telemetry (PII-free)", "HTTPS event payload")

@enduml
