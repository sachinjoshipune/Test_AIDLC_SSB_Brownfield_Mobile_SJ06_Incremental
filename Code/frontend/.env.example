# Copy this file to .env.development / .env.staging / .env.production and
# fill in real values. NEVER commit the resulting .env* files (see .gitignore).
# Consumed by src/config/env.ts via react-native-config.

API_BASE_URL=https://api.example.invalid
API_TIMEOUT_MS=10000
ENVIRONMENT_NAME=development

# --- Web dev-preview only (`npx expo start --web`) ---
# react-native-config (above) is native-only and not used for the web build;
# src/config/env.web.ts reads these EXPO_PUBLIC_* vars instead (auto-loaded
# by `expo/metro-config` from a `.env` file, or set in your shell env).
# Copy the lines below into a `.env` file (project root, gitignored, never
# committed) to point the web preview at a local/mock backend, e.g.:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8090
#   EXPO_PUBLIC_API_TIMEOUT_MS=10000
#   EXPO_PUBLIC_ENVIRONMENT_NAME=development-web-preview
# (http://localhost is allowed here as a narrow local-dev exception; any
# other host still must use HTTPS, same as the native build.)